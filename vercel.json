{
  "version": 2,
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://web-production-016d9.up.railway.app/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://web-production-016d9.up.railway.app/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://web-production-016d9.up.railway.app/openapi.json"
    }
  ]
}
