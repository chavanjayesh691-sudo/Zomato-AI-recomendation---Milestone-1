{
  "version": 2,
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_RAILWAY_APP_URL/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://YOUR_RAILWAY_APP_URL/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://YOUR_RAILWAY_APP_URL/openapi.json"
    }
  ]
}
